# Defaults for production web builds, so a deploy does not depend on someone
# having configured the host by hand. These are the same two values the GitHub
# Actions workflow already carries as defaults in .github/workflows/deploy.yml.
#
# Safe to commit. Every EXPO_PUBLIC_ value is compiled into the bundle in plain
# text and readable by anyone who has the app, so only ever publishable values
# belong here. What keeps one trader's history out of another's app is per-user
# Row Level Security, not secrecy of this key.
#
# A real environment variable on the host always wins over this file: @expo/env
# does not overwrite anything already present in the system environment. So
# Vercel project settings, or a GitHub repo secret of the same name, stay the
# rotation path and need no commit.
#
# Only loaded when NODE_ENV=production, which `expo export` sets. Local dev is
# untouched -- and .env.local outranks this file in every mode regardless.
EXPO_PUBLIC_SUPABASE_URL=https://nqwtetjrzoaggaerriew.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_uDDjcFyVo4Fw3PsAGTXAMQ_zFGIOblV
