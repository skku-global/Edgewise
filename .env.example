# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored; this file is not, so never put real keys here.
#
# Every EXPO_PUBLIC_ value is compiled into the app bundle in plain text and is
# readable by anyone who has the app. Only ever put publishable values here.
# Restart the dev server after editing — env vars are read at bundle time.

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Project Settings → API. The publishable (anon) key is safe to ship *provided*
# scripts/secure-rls.sql has been applied: it is per-user Row Level Security,
# not key secrecy, that keeps one trader's history out of another's app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# ---------------------------------------------------------------------------
# Claude — for the Chat tab (optional; the tab explains itself if unset)
# ---------------------------------------------------------------------------
# Pick ONE of the two below.
#
# Preferred — a proxy that holds the real key server-side, so no key ships in
# the bundle. Start it with:
#   ANTHROPIC_API_KEY=sk-ant-... node scripts/claude-proxy.mjs
EXPO_PUBLIC_CLAUDE_PROXY_URL=http://localhost:8788

# Local prototyping only. This key IS shipped in the bundle in plain text and is
# readable by anyone who opens the app, so never use a live billed key here.
# Leave blank when using the proxy above.
EXPO_PUBLIC_CLAUDE_API_KEY=

# Optional model override. Defaults to claude-sonnet-5.
EXPO_PUBLIC_CLAUDE_MODEL=

# ---------------------------------------------------------------------------
# Auth email delivery — only for scripts/configure-auth.mjs (never the app)
# ---------------------------------------------------------------------------
# None of the values below are read by the app. They exist because Supabase's
# built-in mail server delivers *only* to addresses belonging to members of the
# organisation that owns the project, and refuses everything else with "Email
# address not authorized" — which is why sign-up confirmation and password reset
# appear to send nothing at all. Real SMTP is the fix.
#
# Diagnose first; it needs nothing but the two Supabase values above:
#   node scripts/configure-auth.mjs
#
# A personal access token is account-wide and grants everything your dashboard
# login can. Prefer passing it for a single run over storing it here:
#   SUPABASE_ACCESS_TOKEN=sbp_... node scripts/configure-auth.mjs --apply
SUPABASE_ACCESS_TOKEN=

# Any SMTP provider works. Resend's free tier is the shortest path; the sender
# address has to be on a domain verified with whoever you use.
#   SUPABASE_ACCESS_TOKEN=sbp_... node scripts/configure-auth.mjs --apply --smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=
SMTP_SENDER_NAME=Edgewise
